{
  "name": "@offer-hub/stellar-escrow-signing",
  "version": "1.0.0",
  "description": "Stellar Wallets Kit client-side signing hook for Soroban escrow operations (create, fund, release, refund, dispute)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "stellar",
    "soroban",
    "escrow",
    "wallet",
    "signing",
    "blockchain",
    "web3"
  ],
  "author": "OFFER-HUB",
  "license": "MIT",
  "peerDependencies": {
    "@creit.tech/stellar-wallets-kit": "^2.5.0",
    "react": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.7",
    "@typescript-eslint/eslint-plugin": "^8.52.0",
    "@typescript-eslint/parser": "^8.52.0",
    "eslint": "^9.39.2",
    "prettier": "^3.7.4",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/OFFER-HUB/OFFER-HUB-Frontend.git",
    "directory": "packages/stellar-escrow-signing"
  },
  "bugs": {
    "url": "https://github.com/OFFER-HUB/OFFER-HUB-Frontend/issues"
  },
  "homepage": "https://github.com/OFFER-HUB/OFFER-HUB-Frontend#readme"
}
